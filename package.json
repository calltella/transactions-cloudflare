{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@vinext/cloudflare": "latest",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "^4.149.0"
  },
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "dev": "vinext dev --host 0.0.0.0",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start --",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts"
  }
